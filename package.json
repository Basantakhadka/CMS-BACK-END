{
	"name": "contract-management-system-backend",
	"version": "1.0.0",
	"description": "A NestJS-based Contract Management System backend with authentication, authorization, and core contract lifecycle management features",
	"private": true,
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"clean": "npx rimraf node_modules && npm install",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest --coverage",
		"test:watch": "jest --watch",
		"test:custom": "npm test -- test/unit/crypto.spec.ts",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest .e2e-spec.ts$",
		"prettier:check": "prettier --check ./**/*.{ts,js,json,*rc}",
		"format": "prettier --write \"./**/*.{ts,js,json,*rc}\" \"test/**/*.ts\"",
		"precommit": "lint-staged",
		"prepush": "",
		"db:setup": "docker-compose -f ./docker/docker-compose.yml --env-file ./config/env/.env up -d --build && docker start rest_api_nginx",
		"db:setup:dev": "docker-compose -f ./docker/docker-compose.yml  --env-file ./config/env/.env.dev up -d --build",
		"db:setup:prod": "docker-compose --env-file -f ./docker/docker-compose.yml up  ./config/env/.env.prod -d --build",
		"db:setup:test": "docker-compose --env-file -f docker/docker-compose.yml  ./config/env/.env.test up -d --build",
		"kafka:setup:local-up": "docker-compose -f ./docker/kafka-docker-compose.yml up -d",
		"kafka:setup:local-down": "docker-compose -f ./docker/kafka-docker-compose.yml down -d",
		"doc": "npx @compodoc/compodoc -p tsconfig.json --includesName Documentation --includes wiki/docs --theme stripe",
		"document": "npx @compodoc/compodoc -p tsconfig.json --includesName Documentation --includes wiki/docs --theme stripe -s"
	},
	"author": "Basanta Khadka",
	"license": "MIT",
	"keywords": [
		"contract-management",
		"cms",
		"nestjs",
		"typescript",
		"rest-api",
		"authentication",
		"authorization",
		"typeorm",
		"postgresql"
	],
	"homepage": "https://github.com/Basanta-Khadka-Citytech/contract-management-system-backend",
	"dependencies": {
		"@golevelup/ts-jest": "^0.4.0",
		"@nestjs/common": "^8.4.7",
		"@nestjs/config": "^1.2.1",
		"@nestjs/core": "^8.4.7",
		"@nestjs/event-emitter": "^2.0.2",
		"@nestjs/jwt": "^8.0.1",
		"@nestjs/mapped-types": "^1.2.2",
		"@nestjs/passport": "^8.2.2",
		"@nestjs/platform-express": "^8.4.7",
		"@nestjs/swagger": "^5.2.1",
		"@nestjs/typeorm": "^10.0.1",
		"@types/bcrypt": "^5.0.0",
		"@types/cache-manager": "^4.0.2",
		"@types/jwt-decode": "^3.1.0",
		"axios": "^1.5.0",
		"bcrypt": "^5.0.1",
		"cache-manager": "^5.2.3",
		"cache-manager-redis-store": "^2.0.0",
		"canvas": "^2.11.2",
		"cassandra-driver": "^4.6.4",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.13.2",
		"compression": "^1.7.4",
		"dotenv": "^11.0.0",
		"exceljs": "^4.4.0",
		"express-jwt": "^6.1.2",
		"fast-csv": "^4.3.6",
		"helmet": "5.0.1",
		"juice": "^8.0.0",
		"jwks-rsa": "^2.1.4",
		"jwt-decode": "^3.1.2",
		"kafkajs": "^2.2.4",
		"minio": "^7.0.32",
		"moment-timezone": "^0.5.45",
		"nodemailer": "^6.7.7",
		"pdf-lib": "^1.17.1",
		"pg": "^8.8.0",
		"pg-query-stream": "^4.5.3",
		"pug": "^3.0.2",
		"qrcode": "^1.5.3",
		"redis": "^4.6.13",
		"reflect-metadata": "^0.1.13",
		"rimraf": "^3.0.2",
		"rxjs": "^7.5.6",
		"typeorm": "^0.3.17",
		"typeorm-naming-strategies": "^4.1.0",
		"uuid": "^9.0.0",
		"winston": "^3.8.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^16.3.0",
		"@commitlint/config-conventional": "^16.2.4",
		"@compodoc/compodoc": "^1.1.19",
		"@nestjs/cli": "^8.2.8",
		"@nestjs/schematics": "^8.0.11",
		"@nestjs/testing": "^8.4.7",
		"@types/compression": "^1.7.2",
		"@types/cors": "^2.8.12",
		"@types/express": "^4.17.13",
		"@types/express-serve-static-core": "^4.17.29",
		"@types/jest": "^27.5.2",
		"@types/lodash": "^4.14.182",
		"@types/minio": "^7.0.15",
		"@types/node": "^18.7.23",
		"@types/nodemailer": "^6.4.4",
		"@types/otp-generator": "^4.0.2",
		"@types/passport-jwt": "^3.0.6",
		"@types/pug": "^2.0.6",
		"@types/qrcode": "^1.5.2",
		"@types/supertest": "^2.0.12",
		"@types/uuid": "^9.0.0",
		"@typescript-eslint/eslint-plugin": "^5.31.0",
		"@typescript-eslint/parser": "^5.31.0",
		"commitizen": "^4.2.5",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^8.20.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-import": "^2.26.0",
		"eslint-plugin-prettier": "^4.2.1",
		"jest": "^27.5.1",
		"jest-sonar-reporter": "^2.0.0",
		"lint-staged": "^12.5.0",
		"lodash": "^4.17.21",
		"node-mocks-http": "^1.11.0",
		"prettier": "^2.7.1",
		"supertest": "^6.2.4",
		"swagger-ui-express": "^4.5.0",
		"ts-jest": "^27.1.5",
		"ts-loader": "^9.3.1",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^3.11.0",
		"typescript": "^4.2.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": [
			".*\\.spec\\.ts$",
			".*\\-spec\\.ts$"
		],
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"collectCoverage": true,
		"testResultsProcessor": "jest-sonar-reporter",
		"coverageDirectory": "./coverage",
		"testEnvironment": "node",
		"roots": [
			"<rootDir>/test/"
		],
		"coveragePathIgnorePatterns": [
			"/node_modules/",
			"/tests/"
		],
		"moduleNameMapper": {
			"@app/(.*)": "<rootDir>/src/$1",
			"@app": "<rootDir>/src",
			"@test/(.*)$": "<rootDir>/test/$1"
		}
	}
}
