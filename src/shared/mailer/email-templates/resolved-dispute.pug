html
  head
    style(type="text/css").
      body {
          font-family: Arial, sans-serif;
      }
  body
    div(style="padding:1rem 2rem; font-size: 18px;")
      p(style="margin-top: 1rem;")
        span(style="font-weight: bold;") Dear #{receiverNetworkName},
      div(style="margin-top: 20px;  margin-bottom: 2rem;")
        span Following dispute has been resolved by &nbsp;
        span(style="font-weight: bold;") #{memberName}.&nbsp;
        p Please find the details of dispute below:
      span(style="font-weight: bold;") Dispute Details
      div(style=" padding-top: 5px; gap: 10px;")
        span(style="font-weight: bold;") Transaction ID:&nbsp;
        span #{txnId}
      div(style="padding-top: 5px;")
        span(style="font-weight: bold;") Network Transaction ID:&nbsp;
        span #{networkTxnId}
      div(style="padding-top: 5px;")
        span(style="font-weight: bold;") Transaction Date:&nbsp;
        span #{txnDate}
      div(style="padding-top: 5px;")
        span(style="font-weight: bold;") Dispute Amount:&nbsp;
        span NPR #{disputeAmount}
      div(style="padding-top: 5px;")
        span(style="font-weight: bold;") Dispute Category:&nbsp;
        span #{disputeCategory}
      div(style="padding-top: 5px;")
        span(style="font-weight: bold;") Final Status:&nbsp;
        span #{ finalResolvedstatus}
      div(style="padding-top: 5px;")
        span(style="font-weight: bold;") Remarks:&nbsp;
        span #{remarks}
      div(style="margin-top: 20px;")
        span Thank you,
        p(style="font-weight: bold;") #{memberName}



