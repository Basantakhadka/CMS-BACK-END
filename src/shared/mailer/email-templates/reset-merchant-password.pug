doctype html
html
  head
    meta(charset='UTF-8')
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap')
  body
    div(style='padding: 0 5rem; font-family: Roboto, sans-serif; color: #333;')
      div(style='text-align: center; padding-top: 2rem;')
        img(src=institutionLargeLogo, alt='institution logo', width='150px')

      h2 Dear #{username},

      div(style='margin-bottom: 1rem; font-size: 15px;')
        p
          | We are writing to inform you that your password for the getpay Merchant Portal has been reset.
          br
          br
          | Please find your updated login credentials below:

      div(style='margin-bottom: 1rem; font-size: 15px;')
        span Username:&nbsp;
        span(style='font-weight: 700;') #{merchantUsername}
        br
        span Password:&nbsp;
        span(style='font-weight: 700;') #{merchantPassword}

      a(href=portalLink style='text-decoration: none; display: inline-block; background-color: #2F2E79; color: white; padding: 10px 20px; border-radius: 5px; font-size: 18px; cursor: pointer; margin-top: 1rem;')
        | Click here to log in

      div(style='margin-top: 2rem; margin-bottom: 2rem; font-size: 17px;')
        | For security reasons, please log in and change your password immediately upon first access.

      div(style='margin-bottom: 10px; font-size: 16px; font-weight: 700;') Regards,
      div(style='font-size: 16px; font-weight: 700;') Machhapuchchhre Bank Ltd.

      img(style='margin-bottom: 1rem;', src=institutionLargeLogo, alt='institution large logo', width='60px')
      
      if showPoweredByLogo
        hr
        div(style='float: right; display: flex; gap: 10px; justify-content: end; align-items: center;')
          p(style='font-size: 17px;') Powered By:&nbsp;&nbsp;
          img(style='margin-top: 1.2rem;', width='90px', height='22px', src='cid:getpay', alt='getpay logo')
