doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    style.
      body {
        font-family: Arial, sans-serif;
        color: #333;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
      }
      .container {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 8px;
        overflow: hidden;
      }
      .header {
        background-color: #000000;
        color: #ffffff;
        padding: 20px;
        text-align: center;
        font-size: 24px;
      }
      .content {
        padding: 20px;
        line-height: 1.6;
      }
      .footer {
        background-color: #333;
        color: #ffffff;
        text-align: center;
        padding: 10px;
        font-size: 12px;
      }
      .button {
        display: inline-block;
        padding: 10px 20px;
        margin: 10px 0;
        font-size: 16px;
        color: #ffffff;
        background-color: #4CAF50;
        text-decoration: none;
        border-radius: 5px;
      }
  body
    .container
      .header
        h1 #{institutionName} Email Verification
      
      .content
        p Dear #{username},
        
        p Thank you for choosing #{institutionName}! Before we can provide access to your merchant portal, we need to verify your email address.
        p Please click the button below and follow the instructions to confirm your identity:
        
        a.button(href=verificationLink) Verify Email Address
        
        p This is a crucial step to ensure the security of your account and prevent unauthorized access. Once verified, you will receive your login credentials.
        p Thank you for your cooperation!
        
        p 
          | Best regards,
          br
          | InstantPay Team
      
      .footer
        p &copy; #{currentYear} #{institutionName}. All rights reserved.
        p This is an automated message. Please do not reply to this email.