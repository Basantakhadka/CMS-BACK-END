doctype html
html
  head
    meta(charset='UTF-8')
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap')
  body
    div(style='padding: 0 5rem;')
      div(style='text-align: center; padding-top: 2rem;')
        img(src=institutionLargeLogo, alt='institution logo', width='150px')
      h2 Hi #{name},
      div(style='margin-bottom: 1.2rem; font-size: 15px;')
        p
          | We are delighted to inform you that your account has been successfully created.
          br
          | Please find your login credentials below.
      div(style='margin-bottom: 1rem; font-size: 15px;')
        span Member Code:
        span(style='font-size: 15px; font-weight: 700') #{memberCode}
      div(style='margin-bottom: 1rem; font-size: 15px;')
        span Username:
        span(style='font-size: 15px; font-weight: 700') #{username}
      div(style='margin-bottom: 1.7rem; font-size: 15px;')
        span Password:
        span(style='font-size: 15px; font-weight: 700') #{password}
      a(href=portalLink)
        a(href=portalLink style='text-decoration: none; background-color: #2F2E79; color: white; padding: 10px 20px; border-radius: 5px; font-size: 18px; cursor: pointer;')
          | Click here
          | to login
      div(style='margin-top: 1.5rem; margin-bottom: 1.4rem; font-size: 17px;')
        | As a precautionary measure, we recommend that you change your password as soon as possible after your first login. You will be given a change password page when you sign in for the first time.
        br
        br
        | Should you require any assistance with logging in or have any queries regarding your account, please contact your IT team or Support Team.
      div(style='margin-bottom: 10px; font-size: 16px; font-weight: 700;') Best Regards,
      img(style='margin-bottom: 1rem;', src=institutionLargeLogo, alt='institution large logo', width='60px')

      if showPoweredByLogo
        hr
        div(style='float: right; display: flex; gap: 10px; justify-content: end; align-items: center;')
          p(style='font-size: 17px;') Powered By:&nbsp;&nbsp;
          img(style='margin-top: 1.2rem;', width='90px', height='22px', src='cid:getpay', alt='getpay logo')
